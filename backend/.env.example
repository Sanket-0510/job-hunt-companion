ENV=local

# Supabase Postgres: session pooler URL (port 5432). Write # in the password as %23.
DATABASE_URL=postgresql://app_backend.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Optional: omit to reuse DATABASE_URL (recommended; the direct host is IPv6-only)
# DATABASE_DIRECT_URL=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
RESUME_BUCKET=resumes

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Job Hunt Companion

SESSION_SECRET=change-me
SESSION_TTL_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FRONTEND_ORIGIN=http://localhost:3000
